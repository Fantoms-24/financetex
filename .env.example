# --- База: Neon на проде. Без DATABASE_URL включается PGlite (превью/локально).
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/chekagent?sslmode=require

# --- Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Публичный адрес приложения (прод). Важен для trustedOrigins.
BETTER_AUTH_URL=https://your-app.example

# --- VK ID (необязательный быстрый вход). Оба значения — только в хостинге.
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# --- Web Push / VAPID (стабильная пара! не ротировать на каждом деплое)
# Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# subject — только mailto:... или https://host без пути
VAPID_SUBJECT=mailto:you@example.com

# --- LLM для сканирования чеков и ассистента Листок (Google Gemini 3.8 Flash)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# --- Cron: защита тика пушей
CRON_SECRET=change-me
